# ============================================================
# SpeakMate — Environment Variables
# ============================================================
# Copy to .env:  cp .env.example .env
# Then fill in your values below.
# ============================================================

# --- REQUIRED: LLM Backend ---

# Backend: "anthropic" (Claude — best quality) or "groq" (Llama — free)
# If anthropic is set but no key, auto-falls back to groq
LLM_BACKEND=anthropic

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Anthropic models (default: claude-sonnet-4-20250514 for all tiers)
# ANTHROPIC_MODEL_FAST=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_BALANCED=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_DEEP=claude-sonnet-4-20250514

# Groq API key — free fallback (console.groq.com)
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Groq models (default: llama-3.3-70b-versatile)
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_BALANCED=llama-3.3-70b-versatile
# GROQ_MODEL_DEEP=llama-3.3-70b-versatile

# --- REQUIRED: Supabase (persistent memory) ---

# Project URL (looks like https://abc123.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# anon public key (starts with eyJ...)
SUPABASE_ANON_KEY=your-anon-key

# Service role key — bypasses RLS, keeps data private
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- REQUIRED: Messaging Platform ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token

# Your Telegram user ID (from @userinfobot)
TELEGRAM_USER_ID=your-user-id

# --- RECOMMENDED: User Profile ---

# Your first name (used in prompts)
USER_NAME=Your Name

# Your timezone (IANA format: America/New_York, Europe/Berlin, etc.)
USER_TIMEZONE=UTC

# --- OPTIONAL: Voice ---

# Voice transcription provider: "groq" (free cloud) or "local" (whisper.cpp)
VOICE_PROVIDER=groq

# ElevenLabs TTS (voice replies)
# ELEVENLABS_API_KEY=your-key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- OPTIONAL: Integrations ---

# OpenRouter for Perplexity Sonar web research
# OPENROUTER_API_KEY=your-key

# Google OAuth (for Gmail + Calendar)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret

# --- OPTIONAL: Stripe Payments ---

# Stripe secret key (sk_live_... or sk_test_...)
# STRIPE_SECRET_KEY=sk_test_YOUR_KEY

# Stripe webhook signing secret (whsec_...)
# STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# Stripe Price IDs for subscription tiers
# Create products in Stripe Dashboard: https://dashboard.stripe.com/products
# STRIPE_PRICE_ESSENCIAL=price_YOUR_ESSENCIAL_ID
# STRIPE_PRICE_PREMIUM=price_YOUR_PREMIUM_ID

# Webhook server port (default: 3456)
# WEBHOOK_PORT=3456

# --- OPTIONAL: Agent Configuration ---

# Max agentic turns per request (default: 5)
MAX_AGENT_TURNS=5

# Enable tool use (shell, filesystem, web, etc.)
TOOLS_ENABLED=true

# Require confirmation before dangerous tools (shell, write_file)
TOOLS_REQUIRE_CONFIRMATION=true
